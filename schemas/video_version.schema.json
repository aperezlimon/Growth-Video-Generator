{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "video_version",
  "type": "object",
  "properties": {
    "version_id": {
      "type": "string"
    },
    "renders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "aspect_ratio": {
            "enum": [
              "9:16",
              "4:5",
              "1:1",
              "16:9"
            ]
          },
          "url": {
            "type": "string"
          },
          "duration_s": {
            "type": "number"
          }
        }
      }
    },
    "subtitles_url": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "skills_used": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cost_eur": {
      "type": "number"
    },
    "ai_generated_label_required": {
      "type": "boolean"
    }
  },
  "required": [
    "version_id",
    "renders",
    "skills_used"
  ]
}